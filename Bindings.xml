<Bindings>
    <Binding name="HEADER_PUGRAIDPLAYERBAR" description="Pug Raid Player Bar" header="PUGRAIDPLAYERBAR"/>
    
    <!-- The actual keybinding item -->
    <Binding name="PUGRAID_TARGET_KEY" category="PUGRAIDPLAYERBAR">
        PugRaidPlayerBar_KeybindTarget();
    </Binding>
        <Binding name="PUGRAID_AUTO_TARGET_KEY" category="PUGRAIDPLAYERBAR">
        PugRaidPlayerBar_KeybindAutoTarget();
    </Binding>
    <Binding name="PUGRAID_MOUSEOVER_KEY" category="PUGRAIDPLAYERBAR">
        PugRaidPlayerBar_OnMouseoverKey();
    </Binding>
</Bindings>